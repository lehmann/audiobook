[Unit]
Description=Audiobook Player — auto-update from GitHub
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=lehmann
Group=lehmann
WorkingDirectory=/home/lehmann/github/audiobook
ExecStart=/bin/bash /home/lehmann/github/audiobook/deploy/update.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=audiobook-update

# Allow up to 10 minutes: git pull + docker build + container restart
TimeoutStartSec=600
