[Unit]
Description=Audiobook Player — auto-update from GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/audiobook
ExecStart=/bin/bash /opt/audiobook/deploy/update.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=audiobook-update

# Allow up to 5 minutes for a full npm ci + build
TimeoutStartSec=300
